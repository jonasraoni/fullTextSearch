msgid "plugins.generic.fullTextSearch.name"
msgstr "Plagino por Plena Teksta Serĉo"

msgid "plugins.generic.fullTextSearch.description"
msgstr "Provizas datumbazan plenan tekstan indekson por OJS/OMP/OPS-enmetoj, kongrua kun MySQL kaj PostgreSQL."

msgid "plugins.generic.fullTextSearch.settings.selectContextsDescription"
msgstr "Elektu kiujn kuntekstojn devus havi sian serĉan indekson rekonstruita."

msgid "plugins.generic.fullTextSearch.settings.rebuildButton"
msgstr "Rekonstrui Serĉan Indekson"

msgid "plugins.generic.fullTextSearch.rebuildComplete"
msgstr "Serĉa indekso rekonstruo kompletigita sukcese por la elektitaj kuntekstoj."

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearch"
msgstr "Malplenigi Normajn Serĉajn Tabelojn"

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchDescription"
msgstr "Laŭvole malplenigi la normajn OJS/OMP/OPS serĉajn tabelojn antaŭ rekonstruo. Ĉi tio forigos ĉiujn ekzistantajn serĉajn datumojn de la defaŭlta serĉa sistemo."

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchLabel"
msgstr "Malplenigi normajn serĉajn tabelojn antaŭ rekonstruo de indekso"

msgid "plugins.generic.fullTextSearch.settings.submissionsWaitingToBeIndexed"
msgstr "Enmetoj atendante indeksadon (rekonstrua progreso)"


msgid "plugins.generic.fullTextSearch.settings.description"
msgstr "<p><strong>Por seninterrompan integriĝon sekvu la instrukciojn sube:</strong></p>"
"<ol><li>Post ebligado de la plagino, rekonstruu la serĉan indekson por ĉiuj ĵurnaloj, aŭ rulu <code>php tools/rebuildSearchIndex.php --skip-standard-index</code> (la flago certigas ke nur la datumoj por la plagino estos rekonstruitaj), por plenigi la serĉan indekson de la plagino per datumoj el malnovaj publikaĵoj. Novaj kaj ĝisdatigitaj publikaĵoj estos aŭtomate indeksitaj.</li>"
"<li>Post kiam la indeksado finiĝis, <strong>ebligu la plenan tekstan serĉon</strong> sube kaj kontrolu ĉu la serĉa uzantinterfaco funkcias bone (vi povas testi ĝin serĉante ŝlosilvorton en la serĉa kampo).</li>"
"<li>Se ĉio funkcias bone, vi povas <strong>malebligi la norman indeksadon</strong> sube kaj ankaŭ <strong>malplenigi la normajn serĉajn tabelojn</strong> por ŝpari diskospacon kaj plibonigi la ĝisdatigan rapidecon.</li></ol>"

msgid "plugins.generic.fullTextSearch.settings.useFullTextSearch"
msgstr "Uzu plenan tekstan serĉon. Kiam ebligita, la serĉa interfaco estos funkciigita de la plagino"

msgid "plugins.generic.fullTextSearch.settings.disableStandardIndexing"
msgstr "Malebligu norman indeksadon. Kiam ebligita, la aplikaĵo ĉesos provizi datumojn al la norma serĉa motoro (la plagino faros tion)"

msgid "plugins.generic.fullTextSearch.search.error"
msgstr "Neatendita eraro okazis dum serĉado"
