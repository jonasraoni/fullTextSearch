msgid "plugins.generic.fullTextSearch.name"
msgstr "Olles Teaksta Oažžut Plugin"

msgid "plugins.generic.fullTextSearch.description"
msgstr "Dá OJS/OMP/OPS sáddejumiide databeasa vuođđuduvvon olles teaksta indeksa, mii lea MySQL ja PostgreSQL-vuolli."

msgid "plugins.generic.fullTextSearch.settings.description"
msgstr "<p><strong>Čuovvovaš oahpahusaid čuovvut čuovvovaš integrašuvnna várás, man eai leat čuovvovašat:</strong></p>"
"<ol><li>Maŋŋá go plugin lea aktiverejuvvon, ođđasit čájehut oažžut indeksa buot žurnálaid várás, dahje čuovvut <code>php tools/rebuildSearchIndex.php --skip-standard-index</code> (fálli várrehuvvo ahte dušše plugin-data ođđasit čájehuvvo), plugin oažžut indeksa čájehuvvot boaris almmustahttiide datain. Ođđat ja ođđasit almmustahttit indekseruvvojit automáhtalaččat.</li>"
"<li>Go indekseren lea loahppan, <strong>aktivere olles teaksta oažžut</strong> vuolde ja geahččalge ahte oažžut geavaheaddji interface bargá bures (sáhtát geahččalit dan oažžut sáni boksa oažžut sáni).</li>"
"<li>Jos buot bargá bures, sáhtát <strong>jávkohit standárda indekseren</strong> vuolde ja maid <strong>čájehit standárda oažžut tabellat</strong> diskplaassu várrehuvvot ja ođđasitmáttu vásáhusa nuppástusaid várás.</li></ol>"

msgid "plugins.generic.fullTextSearch.settings.useFullTextSearch"
msgstr "Geavat olles teaksta oažžut. Go lea aktiverejuvvon oažžut interface lea plugin vuođđuduvvon"

msgid "plugins.generic.fullTextSearch.settings.disableStandardIndexing"
msgstr "Jávkohit standárda indekseren. Go lea aktiverejuvvon applikášuvdna jávkohit datu standárda oažžut motora (plugin dohká dan)"

msgid "plugins.generic.fullTextSearch.settings.selectContextsDescription"
msgstr "Vállje maid kontekstaid galge oažžut indeksa ođđasit čájehuvvot."

msgid "plugins.generic.fullTextSearch.settings.rebuildButton"
msgstr "Ođđasit čájehut oažžut indeksa"

msgid "plugins.generic.fullTextSearch.rebuildComplete"
msgstr "Oažžut indeksa ođđasit čájehuvvo ođđasitmáttu buot válljejuvvon kontekstaid várás."

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearch"
msgstr "Čájehit standárda oažžut tabellat"

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchDescription"
msgstr "Válljemeahttun čájehit standárda OJS/OMP/OPS oažžut tabellat ovdal go ođđasit čájehuvvojit. Dát jávkohit buot leat oažžut datu standárda oažžut siste."

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchLabel"
msgstr "Čájehit standárda oažžut tabellat ovdal go indeksa ođđasit čájehuvvo"

msgid "plugins.generic.fullTextSearch.search.error"
msgstr "Čuovvovaš mearkkašupmi šattai oažžut áigge"
