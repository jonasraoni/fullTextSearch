msgid "plugins.generic.fullTextSearch.name"
msgstr "全文搜索插件"

msgid "plugins.generic.fullTextSearch.description"
msgstr "为OJS/OMP/OPS投稿提供基于数据库的全文索引，兼容MySQL和PostgreSQL。"

msgid "plugins.generic.fullTextSearch.settings.selectContextsDescription"
msgstr "选择哪些上下文应该重建其搜索索引。"

msgid "plugins.generic.fullTextSearch.settings.rebuildButton"
msgstr "重建搜索索引"

msgid "plugins.generic.fullTextSearch.rebuildComplete"
msgstr "所选上下文的搜索索引重建已成功完成。"

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearch"
msgstr "清除标准搜索表"

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchDescription"
msgstr "可选地在重建之前清除标准OJS/OMP/OPS搜索表。这将从默认搜索系统中删除所有现有的搜索数据。"

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchLabel"
msgstr "重建索引前清除标准搜索表"


msgid "plugins.generic.fullTextSearch.settings.description"
msgstr "For a seamless integration, without interruptions, follow the instructions below: After enabling the plugin, rebuild the search index for all journals, or run php tools/rebuildSearchIndex.php --skip-standard-index (the flag ensures that only the data for the plugin will be rebuilt), to fill the plugin's search index with data from old publications. New and updated publications will be indexed automatically. Once the indexation is over, enable the full text search below and check if the search user interface is working fine (you can test it by searching for a keyword in the search box). If everything is working properly, you can disable the standard indexing below and also clear the standard search tables to save disk space and improve upgrade speed."

msgid "plugins.generic.fullTextSearch.settings.useFullTextSearch"
msgstr "Use full text search. When enabled the search interface will be powered by the plugin"

msgid "plugins.generic.fullTextSearch.settings.disableStandardIndexing"
msgstr "Disable standard indexing. When enabled the application will stop feeding data to the standard search engine (the plugin will do it)"

msgid "plugins.generic.fullTextSearch.search.error"
msgstr "搜索时发生意外错误"
