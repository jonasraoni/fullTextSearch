msgid "plugins.generic.fullTextSearch.name"
msgstr "Plugin za Pretraživanje Puna Teksta"

msgid "plugins.generic.fullTextSearch.description"
msgstr "Pruža indeks puna teksta temeljen na bazi podataka za OJS/OMP/OPS prijave, kompatibilan s MySQL i PostgreSQL."

msgid "plugins.generic.fullTextSearch.settings.description"
msgstr "<p><strong>Za besprekidnu integraciju, bez prekida, slijedite upute u nastavku:</strong></p><ol><li>Nakon omogućavanja plugina, ponovno izgradite indeks pretraživanja za sve časopise, ili pokrenite <code>php tools/rebuildSearchIndex.php --skip-standard-index</code> (zastavica osigurava da će se ponovno izgraditi samo podaci za plugin), da biste popunili indeks pretraživanja plugina podacima iz starih publikacija. Nove i ažurirane publikacije će se automatski indeksirati.</li><li>Nakon što se indeksiranje završi, <strong>omogućite pretraživanje puna teksta</strong> u nastavku i provjerite da li korisničko sučelje pretraživanja radi dobro (možete testirati pretraživanjem ključne riječi u polju za pretraživanje).</li><li>Ako sve radi ispravno, možete <strong>onemogućiti standardno indeksiranje</strong> u nastavku i također <strong>očistiti standardne tablice pretraživanja</strong> za uštedu prostora na disku i poboljšanje brzine nadogradnje.</li></ol>"

msgid "plugins.generic.fullTextSearch.settings.useFullTextSearch"
msgstr "Koristite pretraživanje puna teksta. Kada je omogućeno, sučelje pretraživanja bit će pokretano pluginom"

msgid "plugins.generic.fullTextSearch.settings.disableStandardIndexing"
msgstr "Onemogućite standardno indeksiranje. Kada je omogućeno, aplikacija će prestati napajati standardni motor pretraživanja podacima (plugin će to učiniti)"

msgid "plugins.generic.fullTextSearch.settings.selectContextsDescription"
msgstr "Odaberite koje kontekste treba ponovno izgraditi indeks pretraživanja."

msgid "plugins.generic.fullTextSearch.settings.rebuildButton"
msgstr "Ponovno Izgradi Indeks Pretraživanja"

msgid "plugins.generic.fullTextSearch.rebuildComplete"
msgstr "Ponovna izgradnja indeksa pretraživanja uspješno je završena za odabrane kontekste."

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearch"
msgstr "Očisti Standardne Tablice Pretraživanja"

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchDescription"
msgstr "Opcionalno očistite standardne OJS/OMP/OPS tablice pretraživanja prije ponovne izgradnje. Ovo će ukloniti sve postojeće podatke pretraživanja iz standardnog sustava pretraživanja."

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchLabel"
msgstr "Očisti standardne tablice pretraživanja prije ponovne izgradnje indeksa"

msgid "plugins.generic.fullTextSearch.settings.submissionsWaitingToBeIndexed"
msgstr "Prijave čekaju indeksiranje (napredak ponovne izgradnje)"

msgid "plugins.generic.fullTextSearch.search.error"
msgstr "Došlo je do neočekivane greške tijekom pretraživanja"
