msgid "plugins.generic.fullTextSearch.name"
msgstr "Plugin Tìm Kiếm Văn Bản Đầy Đủ"

msgid "plugins.generic.fullTextSearch.description"
msgstr "Cung cấp chỉ mục văn bản đầy đủ dựa trên cơ sở dữ liệu cho các bài nộp OJS/OMP/OPS, tương thích với MySQL và PostgreSQL."

msgid "plugins.generic.fullTextSearch.settings.description"
msgstr "<p><strong>Để tích hợp liền mạch, không gián đoạn, hãy làm theo hướng dẫn dưới đây:</strong></p><ol><li>Sau khi bật plugin, xây dựng lại chỉ mục tìm kiếm cho tất cả các tạp chí, hoặc chạy <code>php tools/rebuildSearchIndex.php --skip-standard-index</code> (cờ đảm bảo rằng chỉ dữ liệu của plugin sẽ được xây dựng lại), để lấp đầy chỉ mục tìm kiếm của plugin với dữ liệu từ các ấn phẩm cũ. Các ấn phẩm mới và cập nhật sẽ được lập chỉ mục tự động.</li><li>Khi việc lập chỉ mục kết thúc, <strong>bật tìm kiếm văn bản đầy đủ</strong> bên dưới và kiểm tra xem giao diện người dùng tìm kiếm có hoạt động tốt không (bạn có thể kiểm tra bằng cách tìm kiếm một từ khóa trong hộp tìm kiếm).</li><li>Nếu mọi thứ hoạt động tốt, bạn có thể <strong>tắt lập chỉ mục tiêu chuẩn</strong> bên dưới và cũng <strong>xóa các bảng tìm kiếm tiêu chuẩn</strong> để tiết kiệm không gian ổ đĩa và cải thiện tốc độ nâng cấp.</li></ol>"

msgid "plugins.generic.fullTextSearch.settings.useFullTextSearch"
msgstr "Sử dụng tìm kiếm văn bản đầy đủ. Khi được bật, giao diện tìm kiếm sẽ được cung cấp bởi plugin"

msgid "plugins.generic.fullTextSearch.settings.disableStandardIndexing"
msgstr "Tắt lập chỉ mục tiêu chuẩn. Khi được bật, ứng dụng sẽ ngừng cung cấp dữ liệu cho công cụ tìm kiếm tiêu chuẩn (plugin sẽ xử lý)"

msgid "plugins.generic.fullTextSearch.settings.selectContextsDescription"
msgstr "Chọn các ngữ cảnh nào cần xây dựng lại chỉ mục tìm kiếm."

msgid "plugins.generic.fullTextSearch.settings.rebuildButton"
msgstr "Xây Dựng Lại Chỉ Mục Tìm Kiếm"

msgid "plugins.generic.fullTextSearch.rebuildComplete"
msgstr "Việc xây dựng lại chỉ mục tìm kiếm đã hoàn thành thành công cho các ngữ cảnh đã chọn."

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearch"
msgstr "Xóa Bảng Tìm Kiếm Tiêu Chuẩn"

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchDescription"
msgstr "Tùy chọn xóa các bảng tìm kiếm tiêu chuẩn OJS/OMP/OPS trước khi xây dựng lại. Điều này sẽ loại bỏ tất cả dữ liệu tìm kiếm hiện có từ hệ thống tìm kiếm tiêu chuẩn."

msgid "plugins.generic.fullTextSearch.settings.clearStandardSearchLabel"
msgstr "Xóa bảng tìm kiếm tiêu chuẩn trước khi xây dựng lại chỉ mục"

msgid "plugins.generic.fullTextSearch.settings.submissionsWaitingToBeIndexed"
msgstr "Bài nộp đang chờ lập chỉ mục (tiến trình xây dựng lại)"

msgid "plugins.generic.fullTextSearch.search.error"
msgstr "Đã xảy ra lỗi không mong muốn trong quá trình tìm kiếm"
